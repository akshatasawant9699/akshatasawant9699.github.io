---
import { TIMELINE } from '../site.config';
---
<ol class="timeline">
  {TIMELINE.map((t) => (
    <li>
      <span class="when">{t.when}</span>
      <span><strong>{t.role}</strong>, {t.org} <span class="muted">· {t.place}</span></span>
    </li>
  ))}
</ol>
<style>
  .timeline { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border); }
  .timeline li { position: relative; display: grid; grid-template-columns: 7.5rem 1fr; gap: .25rem 1rem; padding: .4rem 0 .4rem 1.1rem; }
  .timeline li::before { content: ''; position: absolute; left: -6px; top: .95rem; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); }
  .timeline li:first-child::before { background: var(--accent); }
  .when { color: var(--muted); font-size: .9rem; font-variant-numeric: tabular-nums; padding-top: .1rem; }
  @media (max-width: 480px) { .timeline li { grid-template-columns: 1fr; gap: 0; } }
</style>
