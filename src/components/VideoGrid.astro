---
// Grid of videos. Own videos load a privacy-enhanced YouTube embed only when clicked;
// without JS, the thumbnail simply links to YouTube.
import type { CollectionEntry } from 'astro:content';
import VideoCard from './VideoCard.astro';
interface Props { videos: CollectionEntry<'videos'>[]; headingLevel?: 'h2' | 'h3' }
const { videos, headingLevel } = Astro.props;
---
<div class="video-grid">
  {videos.map((v) => <VideoCard video={v} headingLevel={headingLevel} />)}
</div>
<script>
  document.querySelectorAll<HTMLElement>('.yt[data-yt-id]').forEach((box) => {
    const link = box.querySelector('a');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = box.dataset.ytTitle ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.width = '320';
      iframe.height = '180';
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
<style is:global>
  .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem 1.25rem; }
  .video { min-width: 0; }
  .video .yt, .video .yt-thumb { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: var(--surface); }
  .video img, .video iframe { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .yt-play { position: absolute; inset: 0; margin: auto; width: 56px; height: 40px; border-radius: 10px; background: rgba(0,0,0,.72); }
  .yt-play::after { content: ''; position: absolute; left: 22px; top: 11px; border-style: solid; border-width: 9px 0 9px 15px; border-color: transparent transparent transparent #fff; }
  .yt-thumb:hover .yt-play, .yt-thumb:focus-visible .yt-play { background: #c00; }
  .yt-ext { position: absolute; right: 6px; bottom: 6px; font-size: .75rem; font-weight: 600; padding: .1rem .4rem; border-radius: 4px; background: rgba(0,0,0,.75); color: #fff; }
  .video-title { font-size: 1rem; margin: .6rem 0 .1rem; line-height: 1.35; }
  .video-title a { color: var(--fg); text-decoration: none; }
  .video-title a:hover { color: var(--accent); text-decoration: underline; }
  .video .meta { margin: 0 0 .25rem; }
</style>
