---
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { SITE, NAV, LINKS } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}
const props = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111416" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        {/* The home page already shows the name as its heading, so skip it here. */}
        {Astro.url.pathname !== '/' && <a class="site-name" href="/">{SITE.name}</a>}
        <nav class="site-nav" aria-label="Main">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          © {year} {SITE.name}
          {[['LinkedIn', LINKS.linkedin], ['GitHub', LINKS.github], ['YouTube', LINKS.youtube], ['RSS', '/rss.xml']].map(([l, h]) => <>{' · '}<a href={h}>{l}</a></>)}
        </p>
        <p class="small">Views are my own. Built with Astro; no tracking.</p>
      </div>
    </footer>
  </body>
</html>
