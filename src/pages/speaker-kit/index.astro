---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import headshot from '../../assets/headshot.jpg';
import { SITE, SPEAKER, SPOKEN_AT } from '../../site.config';
import { personJsonLd } from '../../lib/jsonld';
const jsonLd = personJsonLd(Astro.site!);
---
<Base title="Speaker kit" description={`Bios, headshot and talk topics for event organisers inviting ${SITE.name} to speak.`}>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <h1>Speaker kit</h1>
  <p>Everything an event organiser needs: bios, a headshot and the topics I speak about. To invite me, <a href="/contact/">get in touch</a>.</p>

  <h2>Short bio</h2>
  <blockquote class="bio"><p>{SPEAKER.shortBio}</p></blockquote>

  <h2>Long bio</h2>
  <blockquote class="bio">{SPEAKER.longBio.map((p) => <p>{p}</p>)}</blockquote>
  <p class="small"><a href="/speaker-kit/bio.txt" download>Download both bios as a text file</a></p>

  <h2>Headshot</h2>
  <Image src={headshot} alt="Portrait of Akshata Sawant" width={200} height={200} widths={[200, 400]} sizes="200px" class="photo" />
  <p class="small"><a href="/press/akshata-sawant-headshot.jpg" download>Download headshot (JPG, 800 × 800)</a></p>

  <h2>Topics</h2>
  <ul class="topics">
    {SPEAKER.topics.map((t) => <li><strong>{t.title}</strong>: {t.detail}</li>)}
  </ul>

  <h2>Formats</h2>
  <p>{SPEAKER.formats.join(' · ')}</p>

  <h2>Spoken at</h2>
  <p>{SPOKEN_AT.join(' · ')}</p>
  <p>Recordings of past talks are on the <a href="/talks/">Talks</a> page.</p>

  <h2>Invite me</h2>
  <p>Send the event name, date, audience and format through the <a href="/contact/">contact page</a>.</p>
</Base>
<style>
  .bio { margin: 0 0 1rem; padding: .25rem 0 .25rem 1rem; border-left: 3px solid var(--accent); }
  .bio p { margin: 0 0 .75rem; }
  .bio p:last-child { margin-bottom: 0; }
  .photo { width: 200px; height: 200px; border-radius: 8px; object-fit: cover; margin-bottom: .25rem; }
  .topics li { margin-bottom: .4rem; }
</style>
