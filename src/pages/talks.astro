---
import Base from '../layouts/Base.astro';
import UpcomingEvent from '../components/UpcomingEvent.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { getTalksSplit, getVideos, isSpeakingVideo, youtubeIdOf, formatMonth, isoDate } from '../lib/content';
import { LINKS } from '../site.config';
const { upcoming, past: talks } = await getTalksSplit();
const meetups = (await getVideos()).filter(isSpeakingVideo);
---
<Base title="Talks" description="Talks by Akshata Sawant at TDX, Dreamforce, Devoxx, APIdays, GopherCon UK, DevOpsDays, London's Calling and MuleSoft meetups, with recordings.">
  <h1>Talks</h1>
  <p class="muted">All my speaking in one place: conferences, workshops, webinars and the MuleSoft meetups I run. Want me to speak at your event? <a href={LINKS.linkedin}>Message me on LinkedIn</a>.</p>
  {upcoming.length > 0 && (
    <>
      <h2>Upcoming</h2>
      <div class="up-list">{upcoming.map((t) => <UpcomingEvent talk={t} />)}</div>
    </>
  )}
  <h2>Conference talks and webinars</h2>
  <ul class="entries">
    {talks.map((t) => {
      const yt = youtubeIdOf(t.data.recording);
      return (
      <li class:list={['talk', { 'has-thumb': yt }]}>
        {yt && (
          <a class="talk-thumb" href={t.data.recording} tabindex="-1" aria-hidden="true">
            <img src={`https://i.ytimg.com/vi/${yt}/mqdefault.jpg`} alt="" width="160" height="90" loading="lazy" decoding="async" />
          </a>
        )}
        <div>
        <span class="talk-title">{t.data.title}</span>
        {t.data.placeholder && <span class="badge">Placeholder</span>}
        <span class="meta">
          {t.data.event} · <time datetime={isoDate(t.data.date)}>{formatMonth(t.data.date)}</time>{t.data.location && <> · {t.data.location}</>}
        </span>
        {t.data.description && <span class="desc small">{t.data.description}</span>}
        {(t.data.recording || t.data.slides) && (
          <span class="links small">
            {t.data.recording && <a href={t.data.recording}>Recording<span class="visually-hidden">: {t.data.title}, {t.data.event}</span></a>}
            {t.data.slides && <a href={t.data.slides}>Slides<span class="visually-hidden">: {t.data.title}</span></a>}
          </span>
        )}
        </div>
      </li>
      );
    })}
  </ul>

  {meetups.length > 0 && (
    <>
      <h2>Meetups and community sessions</h2>
      <p class="muted small">I've led the Mumbai MuleSoft Meetup since 2019 and the London MuleSoft Meetup since 2021. Recordings play here when you click them.</p>
      <VideoGrid videos={meetups} />
    </>
  )}
</Base>
<style>
  .talk-title { font-weight: 600; }
  .talk.has-thumb { display: grid; grid-template-columns: 160px 1fr; gap: 1rem; align-items: start; }
  .talk-thumb img { display: block; width: 160px; height: 90px; object-fit: cover; border-radius: 6px; }
  @media (max-width: 480px) { .talk.has-thumb { grid-template-columns: 112px 1fr; } .talk-thumb img { width: 112px; height: 63px; } }
  .up-list { display: grid; gap: 1rem; }
  .desc { display: block; margin-top: .2rem; }
  .links { display: flex; gap: 1rem; margin-top: .2rem; }
  .links a { font-weight: 500; }
</style>
