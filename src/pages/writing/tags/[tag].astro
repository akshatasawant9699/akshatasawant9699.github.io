---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, getAllTags, tagSlug } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = await getAllTags();
  return tags.map(([tag]) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---
<Base title={`Writing tagged “${tag}”`} description={`Posts by Akshata Sawant tagged ${tag}.`}>
  <p class="small"><a href="/writing/">← All writing</a></p>
  <h1>Tagged “{tag}”</h1>
  <PostList posts={posts} />
</Base>
