---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';
const posts = await getPosts();
---
<Base title="Writing" description="Posts by Akshata Sawant on AI agents, MCP, Agentforce, Data Cloud and MuleSoft, here and on the Salesforce Developers Blog.">
  <h1>Writing</h1>
  <p class="muted">Posts on the Salesforce Developers Blog, the MuleSoft Blog and LinkedIn (marked ↗), newest first. <a href="/rss.xml">RSS feed</a>.</p>
  <PostList posts={posts} />
</Base>
